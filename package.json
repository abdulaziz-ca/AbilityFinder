{
  "name": "abilityfinder",
  "version": "1.0.0",
  "private": true,
  "description": "AbilityFinder \u2014 every disability benefit you can get in Alberta",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "gen:context": "node scripts/gen-benefits-context.js",
    "verify:task": "node --check public/data.js && echo DATA_OK && node scripts/gen-benefits-context.js",
    "gen:guides": "node scripts/gen-guide-pages.js",
    "verify:deploy": "node scripts/verify-deploy.js",
    "check:readability": "node scripts/check-readability.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "fake-indexeddb": "^6.2.5",
    "wrangler": "^4.114.0"
  }
}
