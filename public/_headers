# Cloudflare static-asset headers. Security + caching.
# CSP is strict: only our own origin. 'unsafe-inline' is allowed for STYLES only
# (the app sets inline styles via JS — progress bar, text-size, reading guide);
# scripts are all external files, so script-src stays 'self' (no 'unsafe-inline').
/*
  Strict-Transport-Security: max-age=15552000
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# The embed is the only public asset partners may frame. Detach inherited
# anti-framing headers before applying its isolated CSP.
/embed.html
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'unsafe-inline'; frame-ancestors *; base-uri 'none'; form-action 'none'

/embed
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'unsafe-inline'; frame-ancestors *; base-uri 'none'; form-action 'none'

# Long-cache the fingerprinted/static assets. Fonts are unversioned: they never
# change (a new font gets a new file name), so a ?v bump no longer re-downloads them.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Every page loads these as name?v=N, and a given N never changes content: the
# data-procedure guard (test/data-procedure.test.js) fails CI when one of them
# changes without a ?v bump. So a returning visitor needs no revalidation round
# trip per file (site audit 2026-10, D-ENGINEERING.md P2-1). embed.js is
# unversioned and deliberately absent.
/app.js
  Cache-Control: public, max-age=31536000, immutable
/data.js
  Cache-Control: public, max-age=31536000, immutable
/i18n.js
  Cache-Control: public, max-age=31536000, immutable
/icons.js
  Cache-Control: public, max-age=31536000, immutable
/changelog.js
  Cache-Control: public, max-age=31536000, immutable
/dbManager.js
  Cache-Control: public, max-age=31536000, immutable
/stateManager.js
  Cache-Control: public, max-age=31536000, immutable
/theme-init.js
  Cache-Control: public, max-age=31536000, immutable
/grants-data.js
  Cache-Control: public, max-age=31536000, immutable
/orgs-data.js
  Cache-Control: public, max-age=31536000, immutable
/resultsGroups.js
  Cache-Control: public, max-age=31536000, immutable
/styles.css
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
/guide-prefs.js
  Cache-Control: public, max-age=31536000, immutable

# Always revalidate the HTML so updates appear immediately
/index.html
  Cache-Control: public, max-age=0, must-revalidate
